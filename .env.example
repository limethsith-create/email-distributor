# ── Aviance Trial Machine — environment (SPEC §12) ──────────────────────────
# Only service keys live here. Inbox passwords for trial clients are pasted
# in Mission Control and stored encrypted in Redis.

# Heartbeat: cron-job.org (every minute) and GitHub Actions (every 5 min)
# call /api/cron/tick with `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Mission Control password (also locks the old dashboard pages).
ADMIN_SECRET=
# 32 random bytes, base64. Encrypts inbox passwords. Make with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENC_KEY=

# Vercel KV (Upstash) — set automatically when the KV store is linked.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Owner alerts: sent FROM this inbox (email:app-password:Name) TO OWNER_EMAIL.
OWNER_INBOX=
OWNER_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Healthchecks.io dead-man alarms (tick + nightly backup).
HC_PING_URL=
HC_BACKUP_PING_URL=

# Public address of this app (links in alerts and client emails).
PUBLIC_BASE_URL=https://email-distributor.vercel.app

# Intake (Stage A)
PLACES_API_KEY=
# PORKBUN_API_KEY=
# PORKBUN_SECRET=
AUTO_BUY=false
# DMARC_INBOX=   (email:app-password — falls back to OWNER_INBOX)

# Later phases
# GITHUB_TOKEN=          repository_dispatch for the Lead Finder
# LEADFINDER_TOKEN=
# REOON_API_KEY=
# UPSTASH_EMAIL= / UPSTASH_API_KEY= / UPSTASH_DB_ID=   (optional: real Redis usage numbers)

# ── Legacy (aviance client only) ────────────────────────────────────────────
# Env inboxes still work for the aviance client; "Run first-time setup" in
# Mission Control copies them into Redis (encrypted).
# SMTP_ACCOUNT_1=you@getaviance.site:APP_PASSWORD:Your Name
# FRESH_MIN_SHARE=0.4
# FOLLOWUP_GRACE_DAYS=7

# ── Aviance Trial Machine — environment (SPEC §12) ──────────────────────────
# Only service keys live here. Inbox passwords for trial clients are pasted
# in Mission Control and stored encrypted in Redis. Every variable any file
# reads is listed; the GitHub Actions secrets are listed in docs/PROGRESS.md.

# ── Core (required) ─────────────────────────────────────────────────────────
# Heartbeat secret: cron-job.org (every minute) and GitHub Actions (every
# 5 min) call /api/cron/tick with `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Mission Control password (also locks the old dashboard pages).
ADMIN_SECRET=
# 32 random bytes, base64. Encrypts inbox passwords at rest. Make with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENC_KEY=
# Public address of this app (links in alerts, client emails, page tokens).
PUBLIC_BASE_URL=https://email-distributor.vercel.app

# ── Database (Vercel KV / Upstash) ──────────────────────────────────────────
# Set automatically when the KV store is linked in Vercel.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional: real Redis command counts for the Usage Meter (Upstash management API).
# UPSTASH_EMAIL=
# UPSTASH_API_KEY=
# UPSTASH_DB_ID=

# ── Owner alerts (Notifier) ─────────────────────────────────────────────────
# Owner mail is sent FROM this inbox: email:app-password:Display Name
OWNER_INBOX=
# Where owner alerts and digests go (falls back to DAILY_REPORT_TO).
OWNER_EMAIL=
# Telegram bot for urgent alerts (@BotFather token + your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Healthchecks.io dead-man alarm, pinged at the end of every good tick.
HC_PING_URL=
# (HC_BACKUP_PING_URL is used by the backup GitHub workflow, not by the app.)

# ── Intake (Stage A) ────────────────────────────────────────────────────────
# Google Places API (New): Market Counter (IDs-only, free) and company-name
# lookups for the blocklist.
PLACES_API_KEY=
# Porkbun: live domain availability/pricing; only needed for the Auto-Buyer.
# PORKBUN_API_KEY=
# PORKBUN_SECRET=            (PORKBUN_SECRET_API_KEY is accepted too)
# Buy the domain automatically from Porkbun credit (SPEC §6.4). Off by default.
AUTO_BUY=false
# DMARC report collector inbox (email:app-password); falls back to OWNER_INBOX.
# DMARC_INBOX=

# ── Build (Stage B) ─────────────────────────────────────────────────────────
# GitHub token that may dispatch the Lead Finder workflow (repository_dispatch).
GITHUB_TOKEN=
# owner/repo that runs the Lead Finder (default limethsith-create/email-distributor).
# GITHUB_REPO=
# Shared secret the Lead Finder job sends back to /api/webhooks/leadfinder
# and /api/clients/{id}/profile (same value as the GitHub secret).
LEADFINDER_TOKEN=
# Secret for /api/webhooks/github (Lead Finder run failed); same value as the GitHub secret.
GITHUB_WEBHOOK_SECRET=
# Signs the hidden warm-up marker; falls back to ENC_KEY, then CRON_SECRET.
# WARMUP_SECRET=

# ── Run (Stage C) ───────────────────────────────────────────────────────────
# Reoon Email Verifier: deep checks inside the 20 free credits/day
# (Emergency Runner re-verify; the Lead Finder job has its own copy).
REOON_API_KEY=

# ── Links and tracking (shared) ─────────────────────────────────────────────
# Base URL for unsubscribe / open-tracking links (falls back to
# NEXT_PUBLIC_BASE_URL, then the Vercel URL).
# TRACKING_BASE_URL=
# NEXT_PUBLIC_BASE_URL=
# HMAC secret for unsubscribe + tracking tokens (falls back to CRON_SECRET).
# Changing it invalidates every unsubscribe link already sent.
# TRACKING_SECRET=
# Comma-separated IPs whose pixel loads are ignored (aviance only).
# TRACKING_IGNORE_IPS=
# 'off' removes the open pixel from aviance mail (trial clients never track opens).
# OPEN_TRACKING=

# ── Legacy (aviance client only) ────────────────────────────────────────────
# Env inboxes still work for the aviance client; "Run first-time setup" in
# Mission Control copies them into Redis (encrypted).
# SMTP_ACCOUNT_1=you@getaviance.site:APP_PASSWORD:Your Name
# SMTP_ACCOUNT_1_PROVIDER=google | namecheap | custom   (GMAIL_ACCOUNT_n also read)
# SMTP_HOST=mail.privateemail.com      (custom provider)
# SMTP_PORT=465
# IMAP_HOST=
# EHLO_NAME=
# DAILY_REPORT_TO=                     (aviance end-of-day report recipient)
# FRESH_MIN_SHARE=0.4
# FOLLOWUP_GRACE_DAYS=7

# ── Aviance Hub bridge (docs/HUB-API.md) ────────────────────────────────────
# The hub (aviance.store) signs in through Supabase; the machine verifies its
# tokens against this project's public keys and lets these admins in.
SUPABASE_URL=https://zjbxnkpktbghhudjbxhk.supabase.co
HUB_ADMIN_EMAILS=limethsith@gmail.com
HUB_ORIGINS=https://aviance.store,https://aviance-hub.vercel.app
# Only for a Supabase project that still signs tokens with a shared secret:
# SUPABASE_JWT_SECRET=

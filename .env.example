# ── Sending inboxes ──────────────────────────────────────────────────────────
# One line per inbox (format: email:app-password:Display Name). Gmail/Workspace
# accounts are auto-detected; add SMTP_ACCOUNT_2, _3, … for more inboxes.
SMTP_ACCOUNT_1=you@getaviance.site:YOUR_APP_PASSWORD_HERE:Your Name

# Optional global fallback host (only for non-Gmail providers)
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465

# ── Heartbeat / admin auth ───────────────────────────────────────────────────
# Secret the external pinger sends (Authorization: Bearer <secret> or ?token=).
# When set, all cron + admin endpoints require it. Leave unset = endpoints open.
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Owner daily report (optional) ────────────────────────────────────────────
# Where the 7 PM ET report and switch-off alarm are emailed. Defaults to owner.
# DAILY_REPORT_TO=you@gmail.com

# ── Sending behaviour (optional; sensible defaults) ──────────────────────────
# Share of each inbox's daily cap reserved for fresh day-0 sends (0–0.9).
# FRESH_MIN_SHARE=0.4
# Retire follow-ups more than this many days past due instead of sending them.
# FOLLOWUP_GRACE_DAYS=7

# ── Vercel KV (Upstash) — set automatically when you link a KV store ─────────
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...

{
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*.js": {
      "maxDuration": 60
    },
    "src/app/api/outreach/blast/route.js": {
      "maxDuration": 300
    },
    "src/app/api/cron/auto-send/route.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/auto-send",
      "schedule": "0 6 * * *"
    }
  ]
}
